class BankAccountt
{
	String username;
	double balance;
	
	public BankAccountt(String username, double balance)
	{
		this.username = username; 
		this.balance = balance;
	}
	
	public BankAccountt(String username)
	{
		this.username = username; 
	}
	
	
	
	public void displayBankDetails()
	{
		System.out.println(username);
		System.out.println(balance);
		System.out.println("-------------------");
	}
}


public class Tenth {
	public static void main(String[] args) {
		
		BankAccountt ba1 = new BankAccountt("Raju", 1000);
		BankAccountt ba2 = new BankAccountt("John", 3000);
		BankAccountt ba3 = new BankAccountt("Steve");
		
		ba1.displayBankDetails();
		ba2.displayBankDetails();
		ba3.displayBankDetails();

	}

}

















